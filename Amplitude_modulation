clc;
fm=input('enter the modulating frequency');
vm=input('enter the amplitude of modulating signal');
fc=input('enter the carrier frequency');
vc=input('enter the amplitude of the carrier signal');
t=-5:0.02:5;
m=vm*sin(2*pi*fm*t);
c=sin(2*pi*fc*t);
x=m.*c;
mod=(vc*c)+x;
subplot(3,1,1);
plot(t,m);
xlabel('time');
ylabel('Amplitude');
title('Modulating Signal');
subplot(3,1,2);
plot(t,vc*c);
xlabel('time');
ylabel('Amplitude');
title('Carrier Signal');
subplot(3,1,3);
plot(t,mod);

